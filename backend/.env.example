# Variables de la API. Solo nombres y valores ficticios: los valores reales viven en
# Secret Manager (los marcados como secreto) o en la configuración del servicio de Cloud Run.
# Nunca copies aquí un valor real ni renombres este archivo a .env con valores reales en el repositorio.

# development | test | production
SHALOM_ENV=production

# Secreto. Al menos 50 caracteres aleatorios.
DJANGO_SECRET_KEY=
# Secreto. Llave Fernet para campos cifrados (TOTP, cuerpos de correo pendientes).
SHALOM_FIELD_KEY=

# Host de Cloud Run (SERVICIO-NUMERO.REGION.run.app), separados por coma.
DJANGO_ALLOWED_HOSTS=shalom-api-000000000000.us-central1.run.app
# URL pública de la app (Firebase Hosting); los enlaces de los correos apuntan aquí.
SHALOM_PUBLIC_APP_URL=https://kids-staging.example.invalid
# Orígenes adicionales que pueden enviar formularios, separados por coma.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Cloud SQL por socket de Cloud Run.
PGHOST=/cloudsql/proyecto-ficticio:us-central1:shalom-staging
PGDATABASE=shalom
PGUSER=shalom_app
# Secreto.
PGPASSWORD=

# IP del cliente para el límite por origen (confirmar el número en staging).
SHALOM_CLIENT_IP_HEADER=X-Forwarded-For
SHALOM_TRUSTED_PROXY_COUNT=

# Correo (Brevo por SMTP).
SHALOM_EMAIL_HOST=smtp-relay.example.invalid
SHALOM_EMAIL_PORT=587
SHALOM_EMAIL_USER=
# Secreto.
SHALOM_EMAIL_PASSWORD=
SHALOM_FROM_EMAIL=Shalom <no-responder@example.invalid>

# Cloud Scheduler: cuenta de servicio que firma el token OIDC y audiencia (URL run.app del servicio).
SHALOM_SCHEDULER_SERVICE_ACCOUNT=shalom-scheduler@proyecto-ficticio.iam.gserviceaccount.com
SHALOM_SCHEDULER_AUDIENCE=https://shalom-api-000000000000.us-central1.run.app

# Opcionales de Gunicorn.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
